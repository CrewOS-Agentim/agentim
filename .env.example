# ── Secrets for the local stack (generate with: openssl rand -hex 24) ─────────
RUNNER_TOKEN=change-me
AGENTIM_WEBHOOK_SECRET=change-me
WAHA_API_KEY=change-me
WAHA_DASHBOARD_PASSWORD=change-me
# Token for the gateway API (iOS app, demo script). Defaults to RUNNER_TOKEN.
# AGENTIM_API_TOKEN=

# ── Who may talk to Agent Tim ────────────────────────────────────────────────
# channel:user_id, comma separated. Message the bot once: it replies with your id.
# Use channel:* to allow everyone on that channel (not recommended).
AGENTIM_ALLOWED_USERS=telegram:123456789,slack:U0123456789,whatsapp:15551234567@c.us

# ── Channels (leave empty to disable) ────────────────────────────────────────
# Telegram: talk to @BotFather → /newbot
TELEGRAM_BOT_TOKEN=
# Slack: api.slack.com/apps → Socket Mode on → app token (xapp-, scope connections:write)
#        → bot token (xoxb-, scopes app_mentions:read chat:write files:write im:history im:read)
#        → subscribe to bot events: app_mention, message.im
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# WhatsApp works out of the box via the bundled WAHA container: scan the QR at http://localhost:3000/dashboard

# ── Models ───────────────────────────────────────────────────────────────────
# Hugging Face GGUF models pulled into Docker on first start (memory-checked first).
# AGENTIM_DEFAULT_MODELS=hf.co/unsloth/Qwen3-4B-Instruct-2507-GGUF:Q4_K_M,hf.co/bartowski/Llama-3.2-3B-Instruct-GGUF:Q4_K_M
# Optional cloud models. Local models stay preferred; sensitive prompts never leave your machine.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# economy | balanced | quality
AGENTIM_PRIORITY=balanced
AGENTIM_SHOW_ROUTE=true
